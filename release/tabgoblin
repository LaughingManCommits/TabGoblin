#!/bin/sh
# Starts the TabGoblin server on the Java that came with it. This command is for you: setup, the
# server's window, the pairing token. Your agent is told the Java and the jar themselves, and
# setup prints the line for that.
here=$(cd "$(dirname "$0")" && pwd)
exec "$here/runtime/bin/java" -jar "$here/browser-context-mcp.jar" "$@"
